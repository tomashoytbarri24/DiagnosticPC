# Configuración local opcional de IA. Copia este archivo como .env.
# Nunca subas .env ni compartas tu GROQ_API_KEY.
GROQ_API_KEY=
COREPULSE_GROQ_MODEL=openai/gpt-oss-120b
COREPULSE_AI_ENABLED=1
COREPULSE_AI_WEB_RESEARCH=1
COREPULSE_AI_MAX_WEB_SEARCH_CALLS=12
COREPULSE_AI_RELEVANCE_CACHE_DAYS=14
COREPULSE_AI_STABILITY_REFERENCE_DAYS=45
